{
  "name": "nextrium",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev -w @nextrium/website",
    "build:website": "npm run build -w @nextrium/website",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "brand:check": "tsx scripts/brand-check.ts",
    "brand:new": "tsx scripts/brand-new.ts",
    "dev:dashboard": "npm run dev -w @nextrium/dashboard",
    "build:dashboard": "npm run build -w @nextrium/dashboard"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}
